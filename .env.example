# Backend API base URL (must end with /api)
VITE_API_URL=http://localhost:5000/api

# Razorpay Key ID
# - Required only when backend PAYMENT_MODE=razorpay
# - Test keys start with rzp_test_, live with rzp_live_
# - Backend also returns the key in /payments/create-order, so this is optional
VITE_RAZORPAY_KEY_ID=
